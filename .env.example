# ============================================================
# Пример файла .env для Financial Analyzer
# Скопируйте этот файл в .env и заполните реальными значениями
# ============================================================

# База данных PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=financial_analyzer
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_CONNECT_TIMEOUT=5

# Пул соединений БД
DB_POOL_MIN=2
DB_POOL_MAX=10

# Gunicorn
GUNICORN_WORKERS=2