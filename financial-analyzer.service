[Unit]
Description=Financial Analyzer Gunicorn Server
Documentation=https://github.com/AndreyMinenkov/financial-analyzer
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=forking
PIDFile=/var/run/financial-analyzer.pid
WorkingDirectory=/opt/financial-analyzer

# Переменные окружения (включая пароль БД) берутся из .env — создать его из
# .env.example. Секреты в этом файле не хранятся. Префикс «-» делает файл
# необязательным: если .env нет, переменные прочитает само приложение (db.py).
EnvironmentFile=-/opt/financial-analyzer/.env
Environment=GUNICORN_WORKERS=2

# Запуск gunicorn
ExecStart=/opt/financial-analyzer/.venv/bin/gunicorn --config /opt/financial-analyzer/gunicorn.conf.py server:app
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID

# Перезапуск при сбое
Restart=always
RestartSec=5

# Timeout для graceful shutdown (должен быть > graceful_timeout в gunicorn)
TimeoutStopSec=60

# Запуск от непривилегированного пользователя
# User=financial-analyzer
# Group=financial-analyzer

# Защита
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target